---
import config from "@/config";
type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};
const {
  pubDatetime,
  modDatetime,
  timezone = config.site.timezone,
  class: className,
} = Astro.props;
const modified =
  modDatetime &&
  new Date(modDatetime).getTime() > new Date(pubDatetime).getTime();
const date = new Date(modified ? modDatetime! : pubDatetime);
const label = new Intl.DateTimeFormat("pt-BR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: timezone,
}).format(date);
---

<span class:list={["post-date", className]}
  >{modified ? "Atualizado em " : ""}<time datetime={date.toISOString()}
    >{label}</time
  ></span
>
