---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BrandPhoto from "./BrandPhoto.astro";
import photos from "@/data/product-photos.json";
type Props = {
  src?: string | ImageMetadata;
  alt?: string;
  kind?: string;
  eager?: boolean;
};
const { src, alt = "", kind = "casa", eager = false } = Astro.props;
const brandKinds = [
  "pomar-de-minas",
  "glaeli-no-pomar",
  "glaeli-criando-fragrancias",
] as const;
const brandKind = brandKinds.find(
  name => src === `/images/blog/hanami/${name}-1200.webp`
);
const defaults: Record<string, keyof typeof photos> = {
  casa: "kit-pitanga",
  difusores: "difusor-figo",
  sprays: "spray-pitanga",
  "agua-de-lencois": "tecidos-laranja-lima",
  figo: "difusor-figo",
  pitanga: "difusor-pitanga",
  jabuticaba: "difusor-jabuticaba",
  "laranja-lima": "difusor-laranja-lima",
};
const product =
  Object.values(photos).find(photo =>
    photo.variants.some(v => v.src === src)
  ) ??
  (!src || (typeof src === "string" && src.endsWith("/editorial.svg"))
    ? photos[defaults[kind] ?? "kit-pitanga"]
    : undefined);
const largest = product?.variants.at(-1);
---

{
  product && largest ? (
    <img
      src={largest.src}
      srcset={product.variants.map(v => `${v.src} ${v.width}w`).join(", ")}
      sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 800px"
      alt={product.alt}
      width={largest.width}
      height={largest.height}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
      class="editorial-image product-photo"
    />
  ) : brandKind ? (
    <div class="brand-editorial">
      <BrandPhoto kind={brandKind} {eager} />
    </div>
  ) : typeof src === "object" ? (
    <Image
      src={src}
      alt={alt}
      width={1200}
      loading={eager ? "eager" : "lazy"}
      class="editorial-image"
    />
  ) : (
    <img
      src={src}
      alt={src ? alt : ""}
      width="1200"
      height="900"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="editorial-image"
    />
  )
}
