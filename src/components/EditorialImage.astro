---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BrandPhoto from "./BrandPhoto.astro";
type Props = {
  src?: string | ImageMetadata;
  alt?: string;
  kind?: string;
  eager?: boolean;
};
const { src, alt = "", kind = "casa", eager = false } = Astro.props;
const brandKinds = [
  "pomar-de-minas",
  "glaeli-no-pomar",
  "glaeli-criando-fragrancias",
] as const;
const brandKind = brandKinds.find(
  name => src === `/images/blog/hanami/${name}-1200.webp`
);
const knownKinds = [
  "casa",
  "difusores",
  "sprays",
  "agua-de-lencois",
  "figo",
  "pitanga",
  "jabuticaba",
  "laranja-lima",
];
const fallback =
  "/images/blog/" +
  (knownKinds.includes(kind) ? kind : "casa") +
  "/editorial.svg";
---

{
  brandKind ? (
    <div class="brand-editorial">
      <BrandPhoto kind={brandKind} {eager} />
    </div>
  ) : typeof src === "object" ? (
    <Image
      src={src}
      alt={alt}
      width={1200}
      loading={eager ? "eager" : "lazy"}
      class="editorial-image"
    />
  ) : (
    <img
      src={src ?? fallback}
      alt={src ? alt : ""}
      width="1200"
      height="900"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="editorial-image"
    />
  )
}
