---
import { shop } from "@/data/journal";
const links = [
  ["/", "Início"],
  ["/aromas-para-casa/", "Aromas para Casa"],
  ["/difusores/", "Difusores"],
  ["/sprays-de-ambiente/", "Sprays"],
  ["/agua-de-lencois/", "Água de Lençóis"],
  ["/fragrancias/", "Fragrâncias"],
  ["/guias/", "Guias"],
  ["/sobre/", "Sobre"],
];
const isActive = (href: string) =>
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
---

<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<header class="journal-header">
  <div class="masthead shell">
    <a href="/" class="wordmark" aria-label="HANAMI Journal — início"
      ><img
        src="/brand/hanami-logo.png"
        alt="HANAMI"
        width="720"
        height="240"
        class="brand-logo"
      /><span>JOURNAL</span></a
    >
    <p class="masthead-note">Conheça o aroma. Escolha como usar.</p>
    <div class="header-actions">
      <a class="search-link" href="/search/" aria-label="Buscar no Journal"
        >Buscar <span aria-hidden="true">⌕</span></a
      ><a class="button button-small" href={shop}
        >Loja HANAMI <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <nav class="desktop-nav shell" aria-label="Navegação principal">
    {
      links.map(([href, label]) => (
        <a href={href} aria-current={isActive(href) ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
  <details class="mobile-nav shell">
    <summary>Explorar o Journal <span aria-hidden="true">＋</span></summary><nav
      aria-label="Navegação móvel"
    >
      {
        links.map(([href, label]) => (
          <a href={href} aria-current={isActive(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }<a href={shop}>Loja HANAMI ↗</a>
    </nav>
  </details>
</header>
