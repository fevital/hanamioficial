---
import { ClientRouter } from "astro:transitions";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";
import "@/styles/global.css";
import "@/styles/journal.css";
type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
};
const { site } = config;
const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, site.url).href,
  ogType = "website",
  noindex = false,
} = Astro.props;
const socialImageURL = new URL(ogImage, site.url).href;
const organizationId = "https://www.aromashanami.com.br/#organization";
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "HANAMI",
      logo: new URL("/brand/hanami-logo.png", site.url).href,
      founder: {
        "@type": "Person",
        name: "Glaeli Baldim",
        url: new URL("/autores/glaeli-baldim/", site.url).href,
      },
      url: "https://www.aromashanami.com.br",
      subjectOf: { "@id": site.url + "#blog" },
    },
    {
      "@type": "WebSite",
      "@id": site.url + "#website",
      url: site.url,
      name: site.title,
      description: site.description,
      inLanguage: site.lang,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Blog",
      "@id": site.url + "#blog",
      url: site.url,
      name: "HANAMI Journal",
      description: site.description,
      inLanguage: site.lang,
      publisher: { "@id": organizationId },
      isPartOf: { "@id": site.url + "#website" },
    },
  ],
};
---

<!doctype html>
<html dir={site.dir} lang={site.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="HANAMI Journal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta
      property="og:image:alt"
      content="HANAMI Journal — escolha e cuidado com fragrâncias para casa"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL("rss.xml", site.url)}
    />
    <meta name="theme-color" content="#FAF8F4" />
    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph).replace(/</g, "\\u003c")}
    />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="bg-background font-app text-foreground flex min-h-svh flex-col"
    ><slot /></body>
</html>
