---
import Layout from "./Layout.astro";
import config from "@/config";
import { author, getCategory } from "@/data/journal";
type Props = {
  title: string;
  headline: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime: Date;
  modDatetime?: Date | null;
  category: string;
};
const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL = new URL(Astro.url.pathname, config.site.url).href,
  pubDatetime,
  modDatetime,
  category,
} = Astro.props;
const categoryInfo = getCategory(category);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Article", "BlogPosting"],
      "@id": canonicalURL + "#article",
      headline,
      description,
      url: canonicalURL,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
      image: new URL(ogImage ?? config.site.ogImage, config.site.url).href,
      datePublished: pubDatetime.toISOString(),
      dateModified: (modDatetime ?? pubDatetime).toISOString(),
      inLanguage: "pt-BR",
      articleSection: categoryInfo.name,
      author: {
        "@type": "Person",
        "@id": new URL(author.path, config.site.url).href + "#person",
        name: author.name,
        url: new URL(author.path, config.site.url).href,
      },
      publisher: { "@id": "https://www.aromashanami.com.br/#organization" },
      isPartOf: { "@id": config.site.url + "#blog" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Início",
          item: config.site.url,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: categoryInfo.name,
          item: new URL(categoryInfo.slug + "/", config.site.url).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: headline,
          item: canonicalURL,
        },
      ],
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL} ogType="article">
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={pubDatetime.toISOString()}
    />
    <meta
      property="article:modified_time"
      content={(modDatetime ?? pubDatetime).toISOString()}
    />
    <meta
      property="article:author"
      content={new URL(author.path, config.site.url).href}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </Fragment>
  <slot />
</Layout>
