---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Página não encontrada | HANAMI Journal"
  description="Esta página não está disponível. Continue explorando as histórias do HANAMI Journal."
  canonicalURL="https://blog.aromashanami.com.br/404.html"
  noindex
>
  <Header />
  <main id="main-content" tabindex="-1" class="shell section">
    <div class="page-intro">
      <p class="eyebrow">PÁGINA NÃO ENCONTRADA · 404</p><h1>
        Esta história<br />não está aqui.
      </h1><p>
        Mas há outros caminhos para descobrir. Volte ao Journal ou encontre uma
        leitura pela busca.
      </p><div class="hero-actions">
        <a class="button" href="/">Voltar ao início</a><a
          class="text-link"
          href="/search/">Buscar no Journal ↗</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
