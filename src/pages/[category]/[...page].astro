---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StoryCard from "@/components/StoryCard.astro";
import { categories, fragrances } from "@/data/journal";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
export const getStaticPaths = (async ({ paginate }) => {
  const posts = getSortedPosts(await getCollection("posts"));
  return categories.flatMap(category =>
    paginate(
      posts.filter(post =>
        category.slug === "guias"
          ? post.data.guide
          : post.data.category === category.slug
      ),
      { params: { category: category.slug }, props: { category }, pageSize: 12 }
    )
  );
}) satisfies GetStaticPaths;
type Props = {
  page: Page<CollectionEntry<"posts">>;
  category: (typeof categories)[number];
};
const { page, category } = Astro.props;
const suffix = page.currentPage > 1 ? " — página " + page.currentPage : "";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: config.site.url },
    {
      "@type": "ListItem",
      position: 2,
      name: category.name + suffix,
      item: new URL(Astro.url.pathname, config.site.url).href,
    },
  ],
};
---

<Layout
  title={category.title + suffix + " | HANAMI Journal"}
  description={category.description +
    (page.currentPage > 1 ? " Página " + page.currentPage + "." : "")}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumb)}
  />
  <Header />
  <main id="main-content" tabindex="-1" class="shell category-list">
    <nav class="breadcrumbs" aria-label="Caminho de navegação">
      <a href="/">Início</a><span aria-hidden="true">/</span><span
        aria-current="page">{category.name}{suffix}</span>
    </nav>
    <div class="page-intro">
      <p class="eyebrow">EXPLORE POR ASSUNTO</p><h1>
        {category.name}{suffix}
      </h1><p>{category.intro}</p>
    </div>
    <nav class="category-links" aria-label="Continue explorando">
      {
        category.slug === "fragrancias" || category.slug === "pomar-de-minas"
          ? fragrances.map(fragrance => (
              <a href={"/fragrancias/" + fragrance.slug + "/"}>
                {fragrance.name}
              </a>
            ))
          : categories
              .filter(item => item.slug !== category.slug)
              .slice(0, 6)
              .map(item => <a href={"/" + item.slug + "/"}>{item.name}</a>)
      }
    </nav>
    <div class="story-grid">
      {page.data.map(post => <StoryCard {post} heading="h2" />)}
    </div>
    <nav class="category-links mt-12" aria-label="Paginação">
      {page.url.prev && <a href={page.url.prev}>← Página anterior</a>}<span
        class="px-3 py-2 text-sm"
        >Página {page.currentPage} de {page.lastPage}</span
      >{page.url.next && <a href={page.url.next}>Próxima página →</a>}
    </nav>
  </main>
  <Footer />
</Layout>
