---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StoryCard from "@/components/StoryCard.astro";
import { author } from "@/data/journal";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
const posts = getSortedPosts(await getCollection("posts")).filter(
  post => post.data.authorSlug === "glaeli-baldim"
);
const profile = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": new URL(author.path, config.site.url).href,
      mainEntity: {
        "@id": new URL(author.path, config.site.url).href + "#person",
      },
    },
    {
      "@type": "Person",
      "@id": new URL(author.path, config.site.url).href + "#person",
      name: author.name,
      description: author.description,
      url: new URL(author.path, config.site.url).href,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Início",
          item: config.site.url,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: author.name,
          item: new URL(author.path, config.site.url).href,
        },
      ],
    },
  ],
};
---

<Layout
  title="Glaeli Baldim | Autora do HANAMI Journal"
  description={author.description}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(profile)}
  />
  <Header />
  <main id="main-content" tabindex="-1" class="shell">
    <nav class="breadcrumbs" aria-label="Caminho de navegação">
      <a href="/">Início</a><span>/</span><span aria-current="page"
        >Glaeli Baldim</span>
    </nav>
    <section class="page-intro author-page">
      <p class="eyebrow">QUEM ESCREVE</p><h1>Glaeli Baldim</h1><p>
        {author.description}
      </p><p class="mt-5">
        No Journal, as leituras aproximam as escolhas do dia a dia de um olhar
        mais atento para a casa: conhecer um formato, descobrir uma referência
        olfativa ou encontrar um pequeno ritual que combine com sua rotina.
      </p>
    </section>
    <section class="section">
      <div class="section-heading">
        <h2>Leituras da autora</h2><a class="text-link" href="/posts/"
          >Ver as {posts.length} histórias ↗</a>
      </div><div class="story-grid">
        {posts.slice(0, 12).map(post => <StoryCard {post} />)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
