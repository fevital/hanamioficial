---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BrandPhoto from "@/components/BrandPhoto.astro";
import EditorialImage from "@/components/EditorialImage.astro";
import StoryCard from "@/components/StoryCard.astro";
import { categories, fragrances, shop } from "@/data/journal";
import { getSortedPosts } from "@/utils/getSortedPosts";
const posts = getSortedPosts(await getCollection("posts"));
const featured = ["aromas-casa", "difusor-aromas", "agua-lencois"].flatMap(
  group =>
    posts
      .filter(post => post.data.group === group && post.data.featured)
      .slice(0, 1)
);
const highlights = featured.length ? featured : posts.slice(0, 3);
const guides = ["difusor-varetas", "sprays", "perfume-ambiente"].flatMap(
  group =>
    posts
      .filter(post => post.data.group === group && post.data.guide)
      .slice(0, 1)
);
---

<Layout>
  <Header />
  <main id="main-content" tabindex="-1">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">HANAMI JOURNAL · FRAGRÂNCIAS E CASA</p><h1>
          O aroma começa<br />na <em>escolha.</em>
        </h1><p class="hero-description">
          Entenda as fragrâncias, escolha o formato e aprenda a cuidar do que
          leva para casa. Aqui, a história de cada aroma encontra o uso de todo
          dia.
        </p><div class="hero-actions">
          <a class="button" href="#destaques"
            >Encontrar uma leitura <span aria-hidden="true">↓</span></a
          ><a class="text-link" href={shop}>Conheça a HANAMI ↗</a>
        </div><p class="hero-footnote">
          Do pomar de Glaeli às suas próprias escolhas.
        </p>
      </div>
      <figure class="hero-visual">
        <BrandPhoto kind="glaeli-no-pomar" eager /><figcaption>
          Glaeli Baldim no pomar, uma das referências da coleção Pomar de Minas.
        </figcaption>
      </figure>
    </section>
    <section id="destaques" class="section shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">PARA COMEÇAR A LEITURA</p><h2>
            Matérias em destaque
          </h2>
        </div><a class="text-link" href="/posts/">Todos os artigos ↗</a>
      </div><div class="story-grid">
        {highlights.map(post => <StoryCard {post} />)}
      </div>
    </section>
    <section class="topics-section">
      <div class="shell section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">ESCOLHA SEU CAMINHO</p><h2>
              Explore por assunto
            </h2>
          </div><p>Escolher, aplicar, repor.<br />Comece pela sua dúvida.</p>
        </div><div class="topic-grid">
          {
            categories.slice(0, 5).map((category, i) => (
              <a class="topic-card" href={"/" + category.slug + "/"}>
                <>
                  <span class="eyebrow">0{i + 1}</span>
                  <EditorialImage kind={category.image} />
                  <h3>{category.name}</h3>
                  <span class="topic-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>
    <section class="collection-section shell section">
      <div class="collection-intro">
        <p class="eyebrow">QUATRO FRUTAS. UM LUGAR DE ORIGEM.</p><h2>
          Coleção<br /><em>Pomar de Minas</em>
        </h2><p>
          Mãos roxas de jabuticaba, figos colhidos com a avó, suco de laranja
          lima e pitanga no pomar. Glaeli partiu dessas cenas da infância para
          criar a coleção. Conheça a história e o que distingue cada fragrância.
        </p><a class="text-link" href="/pomar-de-minas/"
          >Conheça a Pomar de Minas ↗</a
        >
      </div><div>
        <BrandPhoto kind="pomar-de-minas" /><div
          class="fragrance-grid collection-fragrance-links"
        >
          {
            fragrances.map(fragrance => (
              <a
                class="fragrance-card"
                href={"/fragrancias/" + fragrance.slug + "/"}
              >
                <>
                  <h3>
                    {fragrance.name}
                    <span aria-hidden="true">↗</span>
                  </h3>
                  <EditorialImage kind={fragrance.slug} />
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>
    <section class="section shell founder-teaser">
      <BrandPhoto kind="glaeli-criando-fragrancias" />
      <div class="collection-intro">
        <p class="eyebrow">QUEM CRIA A HANAMI</p><h2>
          Glaeli Baldim.<br /><em>Uma criação com origem.</em>
        </h2><p>
          A fundadora da HANAMI volta ao sítio onde cresceu para contar como as
          frutas, a avó e as brincadeiras com os irmãos se tornaram referências
          da Pomar de Minas. Assista ao relato de Glaeli.
        </p><a class="text-link" href="/autores/glaeli-baldim/"
          >Conheça Glaeli e sua história ↗</a
        >
      </div>
    </section>
    <section class="section shell guide-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">RESPOSTAS PARA O COTIDIANO</p><h2>Guias HANAMI</h2>
        </div><a class="text-link" href="/guias/">Explorar os guias ↗</a>
      </div><div class="story-grid">
        {guides.map(post => <StoryCard {post} compact />)}
      </div>
    </section>
    <section class="section shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">PARA CONTINUAR</p><h2>Mais leituras do Journal</h2>
        </div><a class="text-link" href="/posts/">Continue explorando ↗</a>
      </div><div class="story-grid">
        {
          posts
            .filter(post => !post.data.editorialNotes)
            .slice(0, 6)
            .map(post => <StoryCard {post} />)
        }
      </div>
    </section>
    <section class="shop-banner">
      <div class="shell">
        <p class="eyebrow">DA LEITURA PARA A SUA CASA</p><h2>
          Qual aroma você quer conhecer?
        </h2><p>
          Compare as notas e escolha entre difusor, spray e água de lençóis.
        </p><a class="button" href={shop}>Visite a loja HANAMI ↗</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
