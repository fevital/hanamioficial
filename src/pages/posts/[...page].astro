---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StoryCard from "@/components/StoryCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { categories } from "@/data/journal";
export const getStaticPaths = (async ({ paginate }) =>
  paginate(getSortedPosts(await getCollection("posts")), {
    pageSize: 12,
  })) satisfies GetStaticPaths;
const { page } = Astro.props;
const suffix = page.currentPage > 1 ? " — página " + page.currentPage : "";
---

<Layout
  title={"Todas as histórias" + suffix + " | HANAMI Journal"}
  description={"Leituras sobre aromas para casa, difusores, sprays, tecidos e as fragrâncias da coleção Pomar de Minas." +
    suffix}
>
  <Header />
  <main id="main-content" tabindex="-1" class="shell category-list">
    <nav class="breadcrumbs" aria-label="Caminho de navegação">
      <a href="/">Início</a><span>/</span><span aria-current="page"
        >Histórias{suffix}</span>
    </nav><div class="page-intro">
      <p class="eyebrow">O JOURNAL</p><h1>Todas as histórias{suffix}</h1><p>
        Aromas, inspiração e pequenos rituais para a casa. Encontre sua próxima
        leitura.
      </p>
    </div><nav class="category-links" aria-label="Explore por assunto">
      {
        categories.map(category => (
          <a href={"/" + category.slug + "/"}>{category.name}</a>
        ))
      }
    </nav><div class="story-grid">
      {page.data.map(post => <StoryCard {post} heading="h2" />)}
    </div><div class="mt-12"><Pagination {page} /></div>
  </main>
  <Footer />
</Layout>
